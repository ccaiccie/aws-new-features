aws_region           = "us-east-1"
project_name         = "nt-ipv6-dns64-lab"
vpc_ipv4_cidr        = "10.64.0.0/16"
public_subnet_ipv4_cidr = "10.64.1.0/24"
create_test_instance = true
instance_type        = "t3.micro"
