region = "us-east-1"
name   = "tgw-gwlb"
azs    = ["us-east-1a", "us-east-1b"]

# GENEVE-capable appliance AMI (required for healthy targets before phase 2)
appliance_ami_id        = ""
appliance_instance_type = "c5.large"
health_check_port       = 80

acceptance_required    = true
enable_network_manager = false

# Phase 2: paste the tgw-attach-... ID from scripts/nf-attachment.sh create
nf_attachment_id = ""
