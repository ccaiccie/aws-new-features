region                    = "us-east-1"
name_prefix               = "dnsfw-lab"
vpc_cidr                  = "10.60.0.0/16"
blocked_domains           = ["blocked.example.com.", "*.bad-example.net."]
allowed_domains           = ["partner.example.org."]
