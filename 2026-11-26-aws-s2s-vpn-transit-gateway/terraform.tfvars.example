# Copy this file to terraform.tfvars and adjust values for your AWS account.
# Do NOT commit terraform.tfvars if it contains real site IPs or secrets.

aws_region          = "us-east-1"
project_name        = "tgw-s2s-vpn-lab"
tgw_asn             = 64512
cgw_asn             = 65000

# Replace with your disposable lab router / simulated customer gateway public IPv4
customer_gateway_ip = "203.0.113.10"
onprem_cidr         = "192.168.100.0/24"

# false = Dynamic BGP routing (recommended, enables TGW ECMP)
# true  = Static routing (creates TGW static route; ECMP not supported)
static_routes_only  = false

# false = Standard Site-to-Site VPN (default)
# true  = Accelerated VPN via AWS Global Accelerator (extra hourly + data charges)
enable_acceleration = false

tunnel1_inside_cidr = "169.254.10.0/30"
tunnel2_inside_cidr = "169.254.20.0/30"
